# Local development only. Never commit real credentials or production values.
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-local-secret
DEBUG=True

# PostgreSQL with PostGIS is required for GeoDjango PointField support.
DB_NAME=porchlight_dev
DB_USER=porchlight
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Alternatively use one DATABASE_URL=postgis://user:password@host:5432/database

# Optional Firebase Admin configuration for local realtime integration testing.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# MailPit SMTP (http://localhost:8025).
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@porchlight.local

# Production email uses SendGrid SMTP; set this only in the production environment.
# SENDGRID_API_KEY=replace-with-sendgrid-api-key

# Optional local frontend origins.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173