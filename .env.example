# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ENV=development

# Database
# Leave DATABASE_URL and USE_POSTGRES unset to use the local SQLite default.
# DATABASE_URL=postgis://postgres:postgres@localhost:5432/porchlight
# USE_POSTGRES=True
# DB_ENGINE=django.contrib.gis.db.backends.postgis
# DB_NAME=porchlight
# DB_USER=porchlight
# DB_PASSWORD=replace-with-database-password
# DB_HOST=localhost
# DB_PORT=5432
# POSTGRES_DB=porchlight
# POSTGRES_USER=porchlight
# POSTGRES_PASSWORD=replace-with-database-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Production hosts and CORS
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=True

# DRF rate limits (production should be tuned with edge/WAF limits)
# DRF_ANON_RATE=100/hour
# DRF_USER_RATE=1000/hour
# DRF_AUTH_RATE=10/minute
# DRF_GUEST_RATE=60/minute

# Email links and sender
DEFAULT_FROM_EMAIL=no-reply@porchlight.local
EMAIL_CONFIRMATION_URL=http://localhost:5173/confirm-email/{uid}/{token}/
PASSWORD_RESET_URL=http://localhost:5173/forgot-password/{uid}/{token}/
MAGIC_LOGIN_URL=http://localhost:5173/magic-login/{uid}/{token}/

# Development email (MailPit). Production uses SendGrid instead.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# SENDGRID_API_KEY=replace-with-sendgrid-api-key

# Firebase Admin SDK. Leave FIREBASE_CREDENTIALS_PATH empty for local runs
# that do not use Firebase synchronization.
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
# FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Geocodio API Key - Needs Single lookup permissions from https://dash.geocod.io/apikey
GEOCODIO_API_KEY=

# Browser Web Push (generate a VAPID key pair; claims is an HTTPS origin such as mailto:ops@example.com)
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_CLAIMS=mailto:ops@example.com

# Celery (optional)
CELERY_BROKER_URL=memory://
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

# Optional observability
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=porchlight@example.com
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# SENTRY_SEND_DEFAULT_PII=False
# NEW_RELIC_ENABLED=False
# NEW_RELIC_LICENSE_KEY=replace-with-new-relic-license-key
# NEW_RELIC_APP_NAME=Porchlight Django